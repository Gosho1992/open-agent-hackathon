# Copy to .env and fill in. Never commit .env.
# --- Meterless Nightshift (primary AI provider) ---
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=paste-the-runtime-proxy-token-here
EXTRACT_MODEL=meterless/vision
REPORT_MODEL=meterless/text.deep
# --- Zetaris (data layer) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=paste-your-zetaris-api-key-here
ZETARIS_DB=AFTERSHOCK
# --- Modes ---
# SAMPLE_MODE=true      run from data/*.csv and recorded model replies (no services needed)
# EXTRACTION=curated    use the human-curated study table instead of vision extraction
# HMEM=off              control run: ignore remembered reviewer policy
