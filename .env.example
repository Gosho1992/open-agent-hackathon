# Copy to .env and fill in. Never commit .env.
# --- Meterless Nightshift (primary AI provider) ---
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=paste-the-runtime-proxy-token-here
EXTRACT_MODEL=openrouter/inclusionai/ling-3.0-flash-vl:free
REPORT_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# --- Zetaris (data layer) ---
# Zetaris UI/API gateway. Login uses the platform's admin account, read automatically
# from zetaris-platform/.env (or set ZETARIS_ADMIN_EMAIL / ZETARIS_ADMIN_PASSWORD).
ZETARIS_URL=http://localhost:3000
ZETARIS_PLATFORM_ENV=zetaris-platform/.env
ZETARIS_DB=lightning.metastore.aftershock.evidence
# --- Modes ---
# SAMPLE_MODE=true      run from data/*.csv and recorded model replies (no services needed)
# DATA_SOURCE=csv       read data from data/*.csv instead of Zetaris, but call models live
# EXTRACTION=curated    use the human-curated study table instead of vision extraction
# HMEM=off              control run: ignore remembered reviewer policy
