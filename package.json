{
  "name": "aftershock",
  "version": "0.1.0",
  "description": "Aftershock: an auditable agent that measures how retracted trials change published meta-analyses",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "npx --yes degit meterless/meterless/engines/hmem/reference vendor/hmem && cd vendor/hmem && npm install --no-audit --no-fund",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "audit": "tsx --env-file-if-exists=.env src/cli.ts audit",
    "policy": "tsx --env-file-if-exists=.env src/cli.ts policy",
    "explain": "tsx --env-file-if-exists=.env src/cli.ts explain",
    "verify-trace": "tsx src/cli.ts verify-trace",
    "conformance": "tsx conformance/runner.ts",
    "zetaris:setup": "tsx --env-file-if-exists=.env scripts/zetaris_setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
